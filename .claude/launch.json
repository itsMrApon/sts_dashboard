{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "scrape-agent",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "agents/python/scrape-agent",
        "python",
        "-m",
        "agent.main"
      ],
      "port": 8100
    }
  ]
}

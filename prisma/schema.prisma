generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String                      @db.VarChar(100)
  clerkId                    String                      @unique
  email                      String                      @unique
  profileImage               String
  stripeConnectId            String?                     @db.VarChar(255)
  lastLoginAt                DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  deletedAt                  DateTime?
  subscription               Boolean                     @default(false)
  stripeCustomerId           String?                     @db.VarChar(255)
  webinars                   Webinar[]                   @relation("PresenterWebinars")
  eventLogs                  EventLog[]
  callTranscripts            CallTranscript[]
  voiceWizards               VoiceWizard[]
  /// One workspace per creator (single-business model).
  workspace                  Workspace?
  partnerConnectors          WorkspacePartnerConnector[]
  huntedLeads                HuntedLead[]
  huntSchedule               HuntSchedule?
  outreachChannels           OutreachChannel[]
  /// One business profile per creator (single-business model).
  publishProfile             PublishProfile?
  voiceCredential            UserVoiceCredential?
  /// Account-wide LLM + voice engine used by every LiveKit agent this user owns.
  agentEngineSettings        AgentEngineSettings?
  liveKitAgents              LiveKitAgent[]
  callIntelConnections       CallIntelConnection[]
  callIntelLeads             CallIntelLead[]
  callIntelMeetings          CallIntelMeeting[]
  callIntelSettings          CallIntelSettings?
  leadImportSources          LeadImportSource[]
  leadImportBatches          LeadImportBatch[]
  leadSearchBatches          LeadSearchBatch[]
  leadActivities             LeadActivity[]
  providerUsageDaily         ProviderUsageDaily[]
  questionGroups             QuestionGroup[]
  whatsAppConnection         WhatsAppConnection?
  reviews                    Review[]
  reviewSettings             ReviewSettings?
  instagramConnection        InstagramConnection?
  instagramCampaigns         InstagramCampaign[]
  /// Platform packages: "Setup & Integrate" ($49 one-time) and "Run My Business" ($499/month).
  /// `subscription` stays the single access flag and is derived from these.
  setupPaidAt                DateTime?
  businessSubscriptionId     String?                     @db.VarChar(255)
  businessSubscriptionStatus String?                     @db.VarChar(32)
  setupRequests              SetupRequest[]
  contacts                   Contact[]
  orders                     Order[]
  paymentRequests            PaymentRequest[]

  @@index([email])
  @@index([clerkId])
}

model UserVoiceCredential {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @unique @db.Uuid
  googleApiKey          String?
  deepgramApiKey        String?
  openaiApiKey          String?
  anthropicApiKey       String?
  fishApiKey            String?
  deepseekApiKey        String?
  kimiApiKey            String?
  openrouterApiKey      String?
  xaiApiKey             String?
  cartesiaApiKey        String?
  elevenlabsApiKey      String?
  googleValidatedAt     DateTime?
  deepgramValidatedAt   DateTime?
  fishValidatedAt       DateTime?
  deepseekValidatedAt   DateTime?
  kimiValidatedAt       DateTime?
  openaiValidatedAt     DateTime?
  anthropicValidatedAt  DateTime?
  openrouterValidatedAt DateTime?
  xaiValidatedAt        DateTime?
  cartesiaValidatedAt   DateTime?
  elevenlabsValidatedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProviderUsageDaily {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid
  provider     String   @db.VarChar(32)
  kind         String   @db.VarChar(8)
  surface      String   @default("app") @db.VarChar(32)
  day          DateTime @db.Date
  requestCount Int      @default(0)
  inputUnits   BigInt   @default(0)
  outputUnits  BigInt   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, kind, surface, day])
  @@index([userId, day])
  @@index([userId, kind, day])
  @@index([userId, surface, day])
}

model Webinar {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String            @db.VarChar(255)
  description     String?
  startTime       DateTime
  endTime         DateTime?
  duration        Int               @default(0)
  webinarStatus   WebinarStatusEnum @default(SCHEDULED)
  presenterId     String            @db.Uuid
  tags            String[]
  ctaLabel        String?           @db.VarChar(50)
  ctaType         CtaTypeEnum
  ctaUrl          String?           @db.VarChar(255)
  couponCode      String?           @db.VarChar(50)
  couponEnabled   Boolean           @default(false)
  couponExpiry    DateTime?
  lockChat        Boolean           @default(false)
  stripeProductId String?           @db.VarChar(255)
  priceId         String?           @db.VarChar(255)
  recordingUrl    String?
  thumbnail       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  attendeeId      String?           @db.Uuid
  livekitAgentId  String?           @db.Uuid
  kind            WebinarKind       @default(PROJECT)
  /// Deprecated: replaced by OfferOrderMode rows; removed once the public pages move to /o/[slug].
  linkVariants    String[]          @default([])
  workspaceId     String?           @db.Uuid
  /// Public share path: /o/{slug}
  slug            String?           @unique @db.VarChar(80)
  attendances     Attendance[]
  questionGroups  QuestionGroup[]
  reviews         Review[]
  publishProducts PublishProduct[]
  orderModes      OfferOrderMode[]
  /// This offer's own guided tour (the Guided tour panel on /o/{slug}).
  tour            VoiceWizard?
  prices          OfferPrice[]
  orders          Order[]
  paymentRequests PaymentRequest[]
  Attendee        Attendee?         @relation(fields: [attendeeId], references: [id])
  presenter       User              @relation("PresenterWebinars", fields: [presenterId], references: [id], onDelete: Cascade)
  workspace       Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([presenterId])
  @@index([startTime])
  @@index([workspaceId])
}

/// The four ways a buyer can order an offer. One row per kind; the creator toggles them.
enum OrderModeKind {
  INSTANT_CHECKOUT
  AI_ASSISTANT
  LIVE_HOST
  DIRECT_PAY
}

model OfferOrderMode {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  webinarId String        @db.Uuid
  kind      OrderModeKind
  enabled   Boolean       @default(true)
  /// Per-mode settings, e.g. AI_ASSISTANT: { services: ["CHAT","SPEAK","WIZARD"] }
  config    Json          @default("{}")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@unique([webinarId, kind])
}

enum OfferPriceKind {
  ONE_TIME
  MONTHLY
  /// Deposit now, Stripe Invoice for the balance after `balanceDueDays`.
  DEPOSIT
}

/// Buyer-facing price options for an offer (max three shown). Amounts are in the smallest currency unit.
model OfferPrice {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  webinarId       String         @db.Uuid
  kind            OfferPriceKind
  label           String?        @db.VarChar(80)
  /// Null only for prices migrated from the legacy `priceId` that have not been synced from Stripe yet.
  amountCents     Int?
  currency        String         @default("usd") @db.VarChar(3)
  depositCents    Int?
  depositPercent  Int?
  balanceDueDays  Int?
  stripeProductId String?        @db.VarChar(255)
  stripePriceId   String?        @db.VarChar(255)
  isDefault       Boolean        @default(false)
  sortOrder       Int            @default(0)
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@index([webinarId])
}

/// A buyer lead, scoped to one creator (unlike the global Attendee table).
model Contact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  email     String?  @db.VarChar(255)
  phone     String?  @db.VarChar(32)
  name      String?  @db.VarChar(100)
  source    String   @default("link") @db.VarChar(32)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders          Order[]
  paymentRequests PaymentRequest[]

  @@unique([userId, email])
  @@unique([userId, phone])
  @@index([userId, createdAt])
}

enum OrderStatus {
  PENDING
  DEPOSIT_PAID
  PAID
  REFUNDED
  FAILED
  CANCELED
}

/// One purchase attempt. Mirrors Stripe state via the webhook; Stripe stays the source of truth for money.
model Order {
  id                      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String         @db.Uuid
  webinarId               String?        @db.Uuid
  offerPriceId            String?        @db.Uuid
  contactId               String?        @db.Uuid
  paymentRequestId        String?        @unique @db.Uuid
  orderMode               OrderModeKind?
  source                  String?        @db.VarChar(64)
  status                  OrderStatus    @default(PENDING)
  currency                String         @default("usd") @db.VarChar(3)
  amountTotalCents        Int            @default(0)
  amountPaidCents         Int            @default(0)
  stripeCheckoutSessionId String?        @unique @db.VarChar(255)
  stripePaymentIntentId   String?        @db.VarChar(255)
  stripeInvoiceId         String?        @db.VarChar(255)
  stripeSubscriptionId    String?        @db.VarChar(255)
  paidAt                  DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  webinar        Webinar?        @relation(fields: [webinarId], references: [id], onDelete: SetNull)
  offerPrice     OfferPrice?     @relation(fields: [offerPriceId], references: [id], onDelete: SetNull)
  contact        Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  paymentRequest PaymentRequest? @relation(fields: [paymentRequestId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([webinarId])
  @@index([contactId])
}

enum PaymentRequestStatus {
  OPEN
  PAID
  EXPIRED
  CANCELED
}

/// A creator-set amount sent to one lead (quotes). Only a human sets the amount.
model PaymentRequest {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String               @db.Uuid
  contactId   String?              @db.Uuid
  webinarId   String?              @db.Uuid
  token       String               @unique @db.VarChar(32)
  amountCents Int
  currency    String               @default("usd") @db.VarChar(3)
  note        String?
  status      PaymentRequestStatus @default(OPEN)
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  webinar Webinar? @relation(fields: [webinarId], references: [id], onDelete: SetNull)
  order   Order?

  @@index([userId, createdAt])
}

enum SetupRequestStatus {
  NEW
  IN_PROGRESS
  DONE
}

/// Created when a creator buys "Setup & Integrate", so the team can follow up.
model SetupRequest {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String             @db.Uuid
  stripePaymentIntentId String             @unique @db.VarChar(255)
  status                SetupRequestStatus @default(NEW)
  notes                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model Attendee {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String         @unique
  name       String         @db.VarChar(100)
  callStatus CallStatusEnum @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  Attendance Attendance[]
  Webinar    Webinar[]
}

model Attendance {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  webinarId    String           @db.Uuid
  joinedAt     DateTime         @default(now())
  leftAt       DateTime?
  attendedType AttendedTypeEnum
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  attendeeId   String           @db.Uuid
  userId       String?          @db.Uuid
  user         Attendee         @relation(fields: [attendeeId], references: [id])
  webinar      Webinar          @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@unique([attendeeId, webinarId])
  @@index([webinarId])
  @@index([attendedType])
}

model RoomEmbedConfig {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomName         String    @unique @db.VarChar(255)
  userId           String    @db.Uuid
  workspaceId      String?   @map("tenantId") @db.Uuid
  publishProfileId String?   @map("businessId") @db.Uuid
  allowedOrigins   String[]  @default([])
  siteKeyHash      String    @unique
  siteKeyPrefix    String    @db.VarChar(32)
  enabled          Boolean   @default(true)
  rotatedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([workspaceId])
  @@index([publishProfileId])
}

model LiveKitAgent {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String         @db.VarChar(255)
  roomName        String         @unique @db.VarChar(255)
  firstMessage    String?
  systemPrompt    String?
  language        String         @default("en") @db.VarChar(10)
  voiceModel      String         @default("db6b0ed5-d5d3-463d-ae85-518a07d3c2b4") @db.VarChar(100)
  voiceProvider   String         @default("cartesia") @db.VarChar(50)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  llmModel        String         @default("gemini-2.0-flash") @db.VarChar(100)
  llmProvider     String         @default("google") @db.VarChar(50)
  /// The one service this assistant is made for: chat | voice | form | tour. Null = classic
  /// (created before per-service assistants), usable by any service.
  service         String?        @db.VarChar(16)
  /// Per-service behaviour (greeting, form questions, call length…) keyed by service.
  /// Looks (colours, orb, theme) stay on the service in /services.
  serviceSettings Json           @default("{}")
  /// Owner. Null for legacy rows created before ownership; claimed on first authorized edit.
  userId          String?        @db.Uuid
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  publishAgents   PublishAgent[]

  @@index([roomName])
  @@index([createdAt])
  @@index([userId])
}

/// Account-wide engine (LLM + TTS voice). Overrides the per-agent llm/voice columns at runtime.
model AgentEngineSettings {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @unique @db.Uuid
  llmProvider      String   @default("google") @db.VarChar(50)
  llmModel         String   @db.VarChar(100)
  voiceProvider    String   @default("cartesia") @db.VarChar(50)
  voiceModel       String   @default("db6b0ed5-d5d3-463d-ae85-518a07d3c2b4") @db.VarChar(100)
  /// Display-only voice title (Fish, Cartesia and ElevenLabs voices are opaque ids).
  voiceLabel       String?  @db.VarChar(200)
  /// "pipeline" (STT -> LLM -> TTS) or "realtime" (one speech-to-speech model).
  engineMode       String   @default("pipeline") @db.VarChar(20)
  sttProvider      String   @default("cartesia") @db.VarChar(50)
  sttModel         String?  @db.VarChar(100)
  /// Speaking-style instructions for TTS/realtime models that accept them (accent, tone).
  voiceStyle       String?  @db.VarChar(500)
  realtimeProvider String   @default("openai") @db.VarChar(50)
  realtimeModel    String   @default("gpt-realtime") @db.VarChar(100)
  realtimeVoice    String   @default("marin") @db.VarChar(100)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MessageChannel {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String?               @db.Uuid
  roomName            String                @db.VarChar(255)
  platform            Platform
  status              ChannelStatus         @default(INACTIVE)
  credentials         Json?
  accountLabel        String?               @db.VarChar(255)
  telegramBotToken    String?
  telegramBotUsername String?
  telegramWebhookSet  Boolean               @default(false)
  discordBotToken     String?
  discordPublicKey    String?
  slackBotToken       String?
  slackTeamId         String?
  slackChannelId      String?
  webinarId           String?               @db.Uuid
  workspaceId         String?               @map("tenantId") @db.Uuid
  publishProfileId    String?               @map("businessId") @db.Uuid
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  conversations       MessageConversation[]
  publishProfile      PublishProfile?       @relation(fields: [publishProfileId], references: [id], onDelete: SetNull)
  workspace           Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@unique([roomName, platform])
  @@index([roomName])
  @@index([roomName, updatedAt])
  @@index([userId])
  @@index([publishProfileId])
  @@index([publishProfileId, updatedAt])
  @@index([workspaceId])
}

model MessageConversation {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channelId  String         @db.Uuid
  externalId String
  platform   Platform
  messages   Json
  /// Set while a person handles the chat (pipeline "Take over", or replying): the AI stays quiet.
  aiPausedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  channel    MessageChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, externalId])
  @@index([channelId])
}

enum AttendedTypeEnum {
  REGISTERED
  ATTENDED
  ADDED_TO_CART
  FOLLOW_UP
  BREAKOUT_ROOM
  CONVERTED
}

enum CtaTypeEnum {
  BUY_NOW
  BOOK_A_CALL
}

enum WebinarKind {
  PROJECT
  PRODUCT
}

enum WebinarStatusEnum {
  SCHEDULED
  WAITING_ROOM
  LIVE
  ENDED
  CANCELLED
}

enum CallStatusEnum {
  PENDING
  InProgress
  COMPLETED
}

enum Platform {
  /// Website chat (Chat AI / hosted page) — conversation history container.
  WEB
  TELEGRAM
  DISCORD
  SLACK
  WHATSAPP
  YOUTUBE
  FACEBOOK_MESSENGER
  INSTAGRAM
  TIKTOK
}

enum ChannelStatus {
  ACTIVE
  INACTIVE
  ERROR
}

model EventLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @db.Uuid
  leadId      String?   @db.Uuid
  workspaceId String?   @map("tenantId") @db.Uuid
  eventType   EventType
  channel     String?   @db.VarChar(50)
  metadata    Json?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([leadId])
  @@index([workspaceId])
  @@index([eventType])
  @@index([createdAt])
}

model CallTranscript {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @db.Uuid
  roomName    String   @db.VarChar(255)
  leadId      String?  @db.Uuid
  workspaceId String?  @map("tenantId") @db.Uuid
  transcript  Json
  duration    Int      @default(0)
  outcome     String?  @db.VarChar(50)
  objections  Json?
  summary     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roomName])
  @@index([leadId])
  @@index([createdAt])
}

model Workspace {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String            @unique @db.Uuid
  publishProfileId     String?           @map("businessId") @db.Uuid
  webinarId            String?           @db.Uuid
  name                 String            @db.VarChar(255)
  pitchMessage         String
  videoUrl             String?           @db.VarChar(500)
  videoType            VideoType         @default(LINK)
  contextVertical      String?           @db.VarChar(100)
  contextCoreJson      Json?
  contextIndustryJson  Json?
  contextSocialJson    Json?
  fullProfileJson      Json?
  compactProfileJson   Json?
  /**
   * Outbound publish modules enabled for this workspace: core, industry, social, blog
   */
  publishModulesJson   Json?
  contextVersion       String?           @db.VarChar(100)
  compactTokenEstimate Int               @default(0)
  contextStatus        ContextStatusEnum @default(DRAFT)
  publishedAt          DateTime?
  /// Setup guide progress: agent | tools | keys. Null = finished (and every pre-existing workspace).
  onboardingStep       String?           @db.VarChar(16)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user              User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishProfile    PublishProfile?             @relation(fields: [publishProfileId], references: [id], onDelete: SetNull)
  voiceWizards      VoiceWizard[]
  serviceConfigs    ServiceConfig[]
  formSubmissions   FormSubmission[]
  messageChannels   MessageChannel[]
  partnerConnectors WorkspacePartnerConnector[]
  webinars          Webinar[]
  telegram          TelegramConnection?
  phoneLine         PhoneLine?

  @@index([userId])
  @@index([userId, createdAt])
  @@index([publishProfileId])
  @@index([publishProfileId, updatedAt])
  @@map("Tenant")
}

/// The creator's own Telegram bot: alerts for buyer chats go to one chat (usually a team group),
/// and replies there are posted back into the buyer's chat.
model TelegramConnection {
  workspaceId   String    @id @db.Uuid
  userId        String    @db.Uuid
  botTokenEnc   String
  botUsername   String    @db.VarChar(64)
  /// Telegram sends this back in X-Telegram-Bot-Api-Secret-Token on every webhook call.
  webhookSecret String    @unique @db.VarChar(64)
  /// Sent as /start <code> from the chat that should get alerts.
  linkCode      String    @db.VarChar(32)
  chatId        String?   @db.VarChar(32)
  chatTitle     String?   @db.VarChar(255)
  enabled       Boolean   @default(true)
  linkedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// The creator's own Twilio number, answered by their Voice AI through LiveKit SIP.
model PhoneLine {
  workspaceId           String   @id @db.Uuid
  userId                String   @db.Uuid
  twilioAccountSid      String   @db.VarChar(64)
  twilioAuthTokenEnc    String
  phoneNumber           String   @db.VarChar(32)
  twilioNumberSid       String   @db.VarChar(64)
  twilioTrunkSid        String?  @db.VarChar(64)
  livekitInboundTrunkId String?  @db.VarChar(64)
  livekitDispatchRuleId String?  @db.VarChar(64)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WorkspacePartnerConnector {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("tenantId") @db.Uuid
  userId      String   @db.Uuid
  kind        String   @db.VarChar(64)
  label       String   @db.VarChar(255)
  mcpUrl      String   @db.VarChar(500)
  authType    String   @default("none") @db.VarChar(32)
  authSecret  String?  @db.VarChar(500)
  enabled     Boolean  @default(true)
  configJson  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


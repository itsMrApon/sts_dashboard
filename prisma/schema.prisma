  userId      String   @id @db.Uuid
  autoRequest Boolean  @default(false)
  delayDays   Int      @default(3)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A creator's Instagram professional account, connected through the platform's Meta app
/// (Instagram API with Instagram Login). Token is long-lived (60 days) and refreshed daily.
model InstagramConnection {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @unique @db.Uuid
  /// The account id Meta puts in webhook entry.id.
  igUserId          String   @unique @db.VarChar(64)
  username          String?  @db.VarChar(64)
  accessTokenEnc    String
  tokenExpiresAt    DateTime?
  webhookSubscribed Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// "Comment PRICE on this reel and get a DM": keywords on one post (or any post) that trigger
/// a private reply, an optional public reply, and a lead for the commenter.
model InstagramCampaign {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @db.Uuid
  /// null = any post or reel of the account.
  mediaId       String?  @db.VarChar(64)
  mediaCaption  String?  @db.VarChar(200)
  mediaThumb    String?  @db.VarChar(1000)
  /// Matched without regard to case; Bangla kept as typed.
  keywords      String[]
  /// "contains" or "word" (whole word).
  matchMode     String   @default("contains") @db.VarChar(16)
  /// The DM. {username} is replaced with the commenter's username.
  dmText        String
  linkUrl       String?  @db.VarChar(500)
  publicReply   String?
  askContact    Boolean  @default(true)
  active        Boolean  @default(true)
  matchedCount  Int      @default(0)
  sentCount     Int      @default(0)
  contactsCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs InstagramDmJob[]

  @@index([userId, active])
}

/// One matched comment: the send queue and the log in one row. One per campaign and comment.
model InstagramDmJob {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId        String    @db.Uuid
  userId            String    @db.Uuid
  commentId         String    @db.VarChar(64)
  commenterId       String    @db.VarChar(64)
  commenterUsername String?   @db.VarChar(64)
  commentText       String
  /// PENDING, SENT, SKIPPED or FAILED.
  status            String    @default("PENDING") @db.VarChar(16)
  attempts          Int       @default(0)
  nextAttemptAt     DateTime  @default(now())
  error             String?
  leadId            String?   @db.Uuid
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  campaign InstagramCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, commentId])
  @@index([status, nextAttemptAt])
  @@index([userId, commenterId])
}

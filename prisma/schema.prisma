generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String    @db.VarChar(100)
  clerkId          String    @unique
  email            String    @unique
  profileImage     String
  stripeConnectId  String?   @db.VarChar(255)
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  subscription     Boolean   @default(false)
  stripeCustomerId String?   @db.VarChar(255)
  webinars         Webinar[]       @relation("PresenterWebinars")
  eventLogs        EventLog[]
  callTranscripts  CallTranscript[]
  workspaces       Workspace[]
  partnerConnectors WorkspacePartnerConnector[]
  huntedLeads      HuntedLead[]
  huntSchedule     HuntSchedule?
  outreachChannels OutreachChannel[]
  publishProfiles  PublishProfile[]
  voiceCredential  UserVoiceCredential?
  callIntelConnections CallIntelConnection[]
  callIntelLeads       CallIntelLead[]
  callIntelMeetings    CallIntelMeeting[]
  callIntelSettings    CallIntelSettings?
  leadSearchBatches    LeadSearchBatch[]
  leadActivities       LeadActivity[]
  providerUsageDaily   ProviderUsageDaily[]

  @@index([email])
  @@index([clerkId])
}

model UserVoiceCredential {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @unique @db.Uuid
  googleApiKey        String?
  deepgramApiKey      String?
  openaiApiKey        String?
  anthropicApiKey     String?
  fishApiKey          String?
  deepseekApiKey      String?
  kimiApiKey          String?
  googleValidatedAt   DateTime?
  deepgramValidatedAt DateTime?
  fishValidatedAt     DateTime?
  deepseekValidatedAt DateTime?
  kimiValidatedAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProviderUsageDaily {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid
  provider     String   @db.VarChar(32)
  kind         String   @db.VarChar(8)
  surface      String   @default("app") @db.VarChar(32)
  day          DateTime @db.Date
  requestCount Int      @default(0)
  inputUnits   BigInt   @default(0)
  outputUnits  BigInt   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, kind, surface, day])
  @@index([userId, day])
  @@index([userId, kind, day])
  @@index([userId, surface, day])
}

model Webinar {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String            @db.VarChar(255)
  description     String?
  startTime       DateTime
  endTime         DateTime?
  duration        Int               @default(0)
  webinarStatus   WebinarStatusEnum @default(SCHEDULED)
  presenterId     String            @db.Uuid
  tags            String[]
  ctaLabel        String?           @db.VarChar(50)
  ctaType         CtaTypeEnum
  ctaUrl          String?           @db.VarChar(255)
  couponCode      String?           @db.VarChar(50)
  couponEnabled   Boolean           @default(false)
  couponExpiry    DateTime?
  lockChat        Boolean           @default(false)
  stripeProductId String?           @db.VarChar(255)
  aiAgentId       String?           @db.Uuid
  priceId         String?           @db.VarChar(255)
  recordingUrl    String?
  thumbnail       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  attendeeId      String?           @db.Uuid
  livekitAgentId  String?           @db.Uuid
  kind            WebinarKind       @default(PROJECT)
  linkVariants    String[]          @default([])
  workspaceId      String?           @db.Uuid
  attendances      Attendance[]
  publishProducts  PublishProduct[]
  Attendee         Attendee?         @relation(fields: [attendeeId], references: [id])
  presenter        User              @relation("PresenterWebinars", fields: [presenterId], references: [id], onDelete: Cascade)
  workspace        Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([presenterId])
  @@index([aiAgentId])
  @@index([startTime])
  @@index([workspaceId])
}

model Attendee {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String         @unique
  name       String         @db.VarChar(100)
  callStatus CallStatusEnum @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  Attendance Attendance[]
  Webinar    Webinar[]
}

model Attendance {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  webinarId    String           @db.Uuid
  joinedAt     DateTime         @default(now())
  leftAt       DateTime?
  attendedType AttendedTypeEnum
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  attendeeId   String           @db.Uuid
  userId       String?          @db.Uuid
  user         Attendee         @relation(fields: [attendeeId], references: [id])
  webinar      Webinar          @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@unique([attendeeId, webinarId])
  @@index([webinarId])
  @@index([attendedType])
}

model RoomEmbedConfig {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomName       String   @unique @db.VarChar(255)
  userId         String   @db.Uuid
  workspaceId    String?  @map("tenantId") @db.Uuid
  publishProfileId String? @map("businessId") @db.Uuid
  allowedOrigins String[] @default([])
  siteKeyHash    String
  siteKeyPrefix  String   @db.VarChar(32)
  enabled        Boolean  @default(true)
  rotatedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([workspaceId])
  @@index([publishProfileId])
}

model LiveKitAgent {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String          @db.VarChar(255)
  roomName       String          @unique @db.VarChar(255)
  firstMessage   String?
  systemPrompt   String?
  language       String          @default("en") @db.VarChar(10)
  voiceModel     String          @default("aura-asteria-en") @db.VarChar(100)
  voiceProvider  String          @default("deepgram") @db.VarChar(50)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  llmModel       String          @default("gemini-2.0-flash") @db.VarChar(100)
  llmProvider    String          @default("google") @db.VarChar(50)
  publishAgents  PublishAgent[]

  @@index([roomName])
  @@index([createdAt])
}

model MessageChannel {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String?               @db.Uuid
  roomName            String                @db.VarChar(255)
  platform            Platform
  status              ChannelStatus         @default(INACTIVE)
  credentials         Json?
  accountLabel        String?               @db.VarChar(255)
  telegramBotToken    String?
  telegramBotUsername String?
  telegramWebhookSet  Boolean               @default(false)
  discordBotToken     String?
  discordPublicKey    String?
  slackBotToken       String?
  slackTeamId         String?
  slackChannelId      String?
  webinarId           String?               @db.Uuid
  workspaceId         String?               @map("tenantId") @db.Uuid
  publishProfileId    String?               @map("businessId") @db.Uuid
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  conversations       MessageConversation[]
  publishProfile      PublishProfile?       @relation(fields: [publishProfileId], references: [id], onDelete: SetNull)
  workspace           Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@unique([roomName, platform])
  @@index([roomName])
  @@index([roomName, updatedAt])
  @@index([userId])
  @@index([publishProfileId])
  @@index([publishProfileId, updatedAt])
  @@index([workspaceId])
}

model MessageConversation {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channelId  String         @db.Uuid
  externalId String
  platform   Platform
  messages   Json
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  channel    MessageChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, externalId])
  @@index([channelId])
}

enum AttendedTypeEnum {
  REGISTERED
  ATTENDED
  ADDED_TO_CART
  FOLLOW_UP
  BREAKOUT_ROOM
  CONVERTED
}

enum CtaTypeEnum {
  BUY_NOW
  BOOK_A_CALL
}

enum WebinarKind {
  PROJECT
  PRODUCT
}

enum WebinarStatusEnum {
  SCHEDULED
  WAITING_ROOM
  LIVE
  ENDED
  CANCELLED
}

enum CallStatusEnum {
  PENDING
  InProgress
  COMPLETED
}

enum Platform {
  TELEGRAM
  DISCORD
  SLACK
  WHATSAPP
  YOUTUBE
  FACEBOOK_MESSENGER
  INSTAGRAM
  TIKTOK
}

enum ChannelStatus {
  ACTIVE
  INACTIVE
  ERROR
}

model EventLog {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @db.Uuid
  leadId     String?   @db.Uuid
  workspaceId String?  @map("tenantId") @db.Uuid
  eventType  EventType
  channel    String?   @db.VarChar(50)
  metadata   Json?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([leadId])
  @@index([workspaceId])
  @@index([eventType])
  @@index([createdAt])
}

model CallTranscript {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  roomName   String   @db.VarChar(255)
  leadId     String?  @db.Uuid
  workspaceId String? @map("tenantId") @db.Uuid
  transcript Json
  duration   Int      @default(0)
  outcome    String?  @db.VarChar(50)
  objections Json?
  summary    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roomName])
  @@index([leadId])
  @@index([createdAt])
}

model Workspace {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @db.Uuid
  publishProfileId String?   @map("businessId") @db.Uuid
  webinarId    String?   @db.Uuid
  name         String    @db.VarChar(255)
  pitchMessage String
  videoUrl     String?   @db.VarChar(500)
  videoType    VideoType @default(LINK)
  contextVertical      String?           @db.VarChar(100)
  contextCoreJson      Json?
  contextIndustryJson  Json?
  contextSocialJson    Json?
  fullProfileJson      Json?
  compactProfileJson   Json?
  /** Outbound publish modules enabled for this workspace: core, industry, social, blog */
  publishModulesJson   Json?
  contextVersion       String?           @db.VarChar(100)
  compactTokenEstimate Int               @default(0)
  contextStatus        ContextStatusEnum @default(DRAFT)
  publishedAt          DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishProfile    PublishProfile?           @relation(fields: [publishProfileId], references: [id], onDelete: SetNull)
  messageChannels   MessageChannel[]
  partnerConnectors WorkspacePartnerConnector[]
  webinars          Webinar[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([publishProfileId])
  @@index([publishProfileId, updatedAt])
  @@map("Tenant")
}

model WorkspacePartnerConnector {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("tenantId") @db.Uuid
  userId      String   @db.Uuid
  kind        String   @db.VarChar(64)
  label       String   @db.VarChar(255)
  mcpUrl      String   @db.VarChar(500)
  authType    String   @default("none") @db.VarChar(32)
  authSecret  String?  @db.VarChar(500)
  enabled     Boolean  @default(true)
  configJson  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
  @@index([workspaceId, enabled])
  @@unique([workspaceId, kind])
  @@map("TenantInboundConnector")
}

model HuntedLead {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String     @db.Uuid
  name            String     @db.VarChar(255)
  email           String?    @db.VarChar(255)
  phone           String?    @db.VarChar(50)
  website         String?    @db.VarChar(255)
  address         String?    @db.VarChar(500)
  businessName    String?    @db.VarChar(255)
  source          LeadSource
  score           LeadScore  @default(COLD)
  scoreReason     String?
  niche           String?    @db.VarChar(255)
  location        String?    @db.VarChar(255)
  rawData         Json?
  outreachSent    Boolean    @default(false)
  outreachChannel String?    @db.VarChar(50)
  outreachSentAt  DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([source])
  @@index([score])
  @@index([createdAt])
}

model HuntSchedule {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @unique @db.Uuid
  niche     String    @db.VarChar(255)
  location  String    @db.VarChar(255)
  sources   String[]
  frequency String    @default("DAILY") @db.VarChar(20)
  enabled   Boolean   @default(false)
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled])
}

enum EventType {
  LEAD_HUNTED
  OUTREACH_SENT
  LINK_CLICKED
  ROOM_JOINED
  CALL_STARTED
  CALL_ENDED
  MESSAGE_REPLIED
  PAYMENT_COMPLETED
  CAMPAIGN_LAUNCHED
  CAMPAIGN_PAUSED
  LEAD_CONVERTED
  LEAD_LOST
}

enum LeadSource {
  GOOGLE_MAPS
  GOOGLE_SEARCH
  LINKEDIN
  INSTAGRAM
  WEBINAR
  MANUAL
}

enum LeadScore {
  HOT
  WARM
  COLD
}

enum VideoType {
  LINK
  UPLOAD
}

enum ContextStatusEnum {
  DRAFT
  PUBLISHED
  STALE
}

enum OutreachStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum LeadState {
  OUTREACHED
  OPENED
  CLICKED_LINK
  JOINED_ROOM
  CONVERTED
  LOST
}

enum ApprovalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SENT
  SKIPPED
}

enum OutreachPlatform {
  EMAIL
  WHATSAPP
  INSTAGRAM_DM
  FACEBOOK_DM
  TIKTOK_DM
  YOUTUBE
  WEBSITE
  TELEGRAM
  WECHAT
}

model OutreachChannel {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String           @db.Uuid
  publishProfileId String?          @map("businessId") @db.Uuid
  platform         OutreachPlatform
  status           ChannelStatus    @default(INACTIVE)
  credentials      Json?
  accountLabel     String           @db.VarChar(255)
  pageUrl          String?          @db.VarChar(500)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishProfile PublishProfile? @relation(fields: [publishProfileId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, platform])
  @@index([publishProfileId])
}

model PublishProfile {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @db.Uuid
  name           String   @db.VarChar(255)
  description    String?
  logo           String?
  isHomeFeatured Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  agents           PublishAgent[]
  products         PublishProduct[]
  channels         MessageChannel[]
  outreachChannels OutreachChannel[]
  workspaces       Workspace[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, isHomeFeatured])
  @@map("Business")
}

model PublishAgent {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publishProfileId String   @map("businessId") @db.Uuid
  agentId          String   @db.Uuid
  isPrimary        Boolean  @default(false)
  createdAt        DateTime @default(now())

  publishProfile PublishProfile @relation(fields: [publishProfileId], references: [id], onDelete: Cascade)
  agent          LiveKitAgent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([publishProfileId, agentId])
  @@index([publishProfileId])
  @@index([publishProfileId, isPrimary])
  @@index([agentId])
  @@index([agentId, publishProfileId])
  @@map("BusinessAgent")
}

model PublishProduct {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publishProfileId String   @map("businessId") @db.Uuid
  webinarId        String   @db.Uuid
  isPrimary        Boolean  @default(false)
  createdAt        DateTime @default(now())

  publishProfile PublishProfile @relation(fields: [publishProfileId], references: [id], onDelete: Cascade)
  webinar        Webinar        @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@unique([publishProfileId, webinarId])
  @@index([publishProfileId])
  @@index([publishProfileId, isPrimary])
  @@index([webinarId])
  @@map("BusinessProduct")
}

enum StreamCallStatus {
  PENDING
  ACTIVE
  ENDED
}

model StreamCallSession {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomName          String            @db.VarChar(255)
  webinarId         String            @db.Uuid
  callId            String            @unique @db.VarChar(255)
  hostUserId        String            @db.Uuid
  attendeeUserId    String            @db.VarChar(255)
  attendeeIdentity  String            @db.VarChar(255)
  status            StreamCallStatus @default(PENDING)
  attendeeJoinedAt  DateTime?
  creatorJoinedAt   DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([roomName])
  @@index([webinarId])
}

enum CallIntelProvider {
  FATHOM
  GOOGLE_CALENDAR
}

enum CallIntelConnectionStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum CallIntelBriefStatus {
  PENDING
  READY
  FAILED
}

model CallIntelConnection {
  id          String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String                     @db.Uuid
  provider    CallIntelProvider
  credentials Json?
  status      CallIntelConnectionStatus  @default(ACTIVE)
  metadata    Json?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
}

model CallIntelLead {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String               @db.Uuid
  email             String               @db.VarChar(255)
  name              String               @db.VarChar(255)
  company           String?              @db.VarChar(255)
  notes             String?
  selectedAgentId   String?              @db.Uuid
  lastAppointmentAt DateTime?
  webResearchJson   Json?
  /** MEETING = Fathom/Calendar; BUSINESS = Serper Maps cold outreach */
  source            String               @default("MEETING") @db.VarChar(20)
  phone             String?              @db.VarChar(50)
  website           String?              @db.VarChar(500)
  address           String?              @db.VarChar(500)
  placeId           String?              @db.VarChar(100)
  /** Manual outbound pipeline: NEW | ON_PROCESS | DONE */
  outboundStatus    LeadOutboundStatus   @default(NEW)
  searchBatchId     String?              @db.Uuid
  nextFollowUpAt    DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  searchBatch LeadSearchBatch?  @relation(fields: [searchBatchId], references: [id], onDelete: SetNull)
  meetings    CallIntelMeeting[]
  briefs      CallIntelBrief[]
  activities  LeadActivity[]

  @@unique([userId, email])
  @@index([userId])
  @@index([userId, lastAppointmentAt])
  @@index([userId, source])
  @@index([userId, placeId])
  @@index([userId, outboundStatus])
  @@index([searchBatchId])
  @@index([userId, nextFollowUpAt])
  @@index([selectedAgentId])
}

model LeadSearchBatch {
  id        String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String                  @db.Uuid
  location  String                  @db.VarChar(255)
  niche     String                  @db.VarChar(255)
  source    LeadSearchBatchSource   @default(MANUAL)
  createdAt DateTime                @default(now())

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads CallIntelLead[]

  @@index([userId])
  @@index([userId, createdAt])
}

model LeadActivity {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String           @db.Uuid
  leadId        String           @db.Uuid
  type          LeadActivityType
  note          String?
  scheduledAt   DateTime?
  googleEventId String?          @db.VarChar(255)
  meetLink      String?          @db.VarChar(500)
  createdAt     DateTime         @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead CallIntelLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([leadId])
  @@index([userId, scheduledAt])
  @@index([leadId, createdAt])
}

enum LeadOutboundStatus {
  NEW
  ON_PROCESS
  DONE
}

enum LeadSearchBatchSource {
  CRON
  MANUAL
}

enum LeadActivityType {
  NOTE
  APPROACH
  FOLLOW_UP
  MEET_SCHEDULED
}

model CallIntelMeeting {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @db.Uuid
  leadId            String?  @db.Uuid
  fathomRecordingId String   @unique @db.VarChar(100)
  summary           String?
  actionItems       Json?
  participants      Json?
  recordedAt        DateTime
  duration          Int?
  fathomUrl         String?  @db.VarChar(500)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead   CallIntelLead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  scores CallIntelScriptScore[]

  @@index([userId])
  @@index([leadId])
  @@index([recordedAt])
}

model CallIntelScriptScore {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId String   @db.Uuid
  agentId   String   @db.Uuid
  covered   String[] @default([])
  missed    String[] @default([])
  issues    String[] @default([])
  nextSteps String[] @default([])
  rawJson   Json?
  scoredAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting CallIntelMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([agentId])
  @@index([scoredAt])
}

model CallIntelBrief {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId           String               @db.Uuid
  forDate          DateTime             @db.Date
  calendarEventId  String?              @db.VarChar(255)
  formSnapshot     Json?
  researchSnapshot Json?
  status           CallIntelBriefStatus @default(PENDING)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  lead CallIntelLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, forDate, calendarEventId])
  @@index([leadId])
  @@index([forDate])
}

/** Per-user Call Intelligence setup (agent + projects + calendar). */
model CallIntelSettings {
  userId             String    @id @db.Uuid
  defaultAgentId     String?   @db.Uuid
  selectedWebinarIds String[]  @default([])
  /** ALL = every event today; KEYWORD = match calendarKeyword in title/description */
  calendarFilterMode String    @default("ALL") @db.VarChar(20)
  calendarKeyword    String?   @db.VarChar(100)
  /** Optional per-user Google OAuth app credentials (encrypted). Env used as fallback. */
  googleClientIdEnc  String?
  googleClientSecretEnc String?
  /** Optional per-user Serper API key (encrypted). Env SERPER_API_KEY used as fallback. */
  serperApiKeyEnc    String?
  /** Business lead discovery: city/area + niche for Serper Maps sync */
  businessLocation   String?   @db.VarChar(255)
  businessNiche      String?   @db.VarChar(255)
  setupCompletedAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Questions customers asked, grouped by meaning, for one creator and one project (webinarId)
/// or none (General: website chats about no project). Rebuilt by the Questions job; the
/// creator's status and answer are kept across runs. Approved answers feed every agent.
model QuestionGroup {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @db.Uuid
  webinarId      String?   @db.Uuid
  /// Short name for the question, in the language customers used.
  label          String    @db.VarChar(200)
  /// Up to 5 real questions as asked, personal details removed, newest first.
  examples       Json      @default("[]")
  askedCount     Int       @default(0)
  /// Times the visitor said nothing more after this question was answered.
  wentQuietCount Int       @default(0)
  /// OPEN, ANSWERED or IGNORED.
  status         String    @default("OPEN") @db.VarChar(16)
  /// The creator's answer. Agents use it once status is ANSWERED.
  answer         String?
  answeredAt     DateTime?
  lastAskedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  webinar Webinar? @relation(fields: [webinarId], references: [id], onDelete: SetNull)

  @@unique([userId, webinarId, label])
  @@index([userId, status])
}

/// A creator's own WhatsApp number, connected through their Kapso project (Integrations →
/// WhatsApp). Keys are encrypted. Kapso posts customer messages to
/// /api/whatsapp/webhook/<token>; the token is stored hashed (and encrypted, to show it again).
model WhatsAppConnection {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @unique @db.Uuid
  provider         String    @default("kapso") @db.VarChar(16)
  apiKeyEnc        String
  phoneNumberId    String    @db.VarChar(64)
  /// The secret_key set on the Kapso webhook; every delivery is signed with it.
  webhookSecretEnc String
  webhookTokenEnc  String
  webhookTokenHash String    @unique @db.VarChar(64)
  displayPhone     String?   @db.VarChar(32)
  /// Reply to customers with the Chat AI assistant.
  aiReplies        Boolean   @default(true)
  lastInboundAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Webhook deliveries already handled (Kapso's X-Idempotency-Key, Meta ids), so retries
/// never answer a customer twice. Old rows are cleaned up by the cleanup job.
model WebhookDelivery {
  key       String   @id @db.VarChar(200)
  source    String   @db.VarChar(32)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// A customer's review of a creator. Starts as a request (a private link /review/<token>),
/// becomes SUBMITTED when the customer writes it, and shows on the website only once the
/// creator APPROVES it (or HIDDEN). Text is kept exactly as written, Bangla included.
model Review {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @db.Uuid
  webinarId    String?   @db.Uuid
  /// The paid order that triggered the request (one request per order).
  orderId      String?   @unique @db.Uuid
  contactId    String?   @db.Uuid
  token        String    @unique @db.VarChar(64)
  customerName String?   @db.VarChar(100)
  rating       Int?
  text         String?
  /// REQUESTED, SUBMITTED, APPROVED or HIDDEN.
  status       String    @default("REQUESTED") @db.VarChar(16)
  requestedAt  DateTime  @default(now())
  /// When the request email went out (null: link only, copied by the creator).
  sentAt       DateTime?
  submittedAt  DateTime?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  webinar Webinar? @relation(fields: [webinarId], references: [id], onDelete: SetNull)

  @@index([userId, status])
}

